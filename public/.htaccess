# SPA fallback for React Router. Without this, any deep-link URL (e.g. /auth/callback,
# /auth/register/google, or a page refresh on any admin/sales/etc. route) 404s on a plain
# Apache static host - the server looks for a real file/folder at that path and finds nothing,
# since these routes only exist inside the React app's JS router, not on disk.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files and directories (JS, CSS, images, etc.) be served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # A missing build asset (stale chunk after a redeploy, typo'd path, etc.) must 404, never
  # silently fall back to index.html - an HTML page served with a .js/.css content type breaks
  # the browser's module loader with a confusing "Unexpected token '<'" instead of a clean,
  # detectable network error. ChunkErrorBoundary.jsx specifically looks for a failed dynamic
  # import to show its "a new version is available" message - that detection only works if a
  # missing chunk actually 404s instead of silently resolving to index.html's markup.
  RewriteRule ^assets/.*\.(js|css|map)$ - [R=404,L]

  # Everything else falls back to index.html so React Router can handle the route.
  RewriteRule ^ index.html [L]
</IfModule>
