        "invoice_items_qty_sum": 20
      },
      "expected_behavior": "invoice item quantity == delivered quantity (12), per invoice_timing=after_delivery and partial_delivery_invoice_mode=per_delivery",
      "business_impact": "Customer would be billed for goods not yet physically delivered on a partially-delivered order - a real overbilling/accounting-correctness issue, not cosmetic.",
      "probable_cause": "Order-to-invoice conversion appears to bill the full ORDERED quantity rather than the actually-DELIVERED quantity when the order was only partially delivered.",
      "recommended_fix": "Verify the invoice line-item quantity source: should sum delivered_quantity from the order's deliveries, not the original order line quantity, when partial_delivery_invoice_mode=per_delivery."
    }
