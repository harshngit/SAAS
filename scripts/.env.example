# Copy this file to .env and fill in real values before running `npm run seed`

# Backend base URL (already matches your frontend's src/api/client.js)
API_BASE_URL=https://crm-saas-backend-9nom.onrender.com/

# --- Admin account the script logs in as ---
# If REGISTER_NEW_ORG=true, the script creates a brand-new org + admin using these
# credentials instead of logging in. Use this for a clean sandbox org.
REGISTER_NEW_ORG=true
ORG_NAME=Seed Demo Traders
ADMIN_NAME=Demo Admin
ADMIN_EMAIL=demo.admin@seedtest.local
ADMIN_PASSWORD=DemoPass123!

# --- Where to pull dummy images/documents from ---
# Any .jpg/.jpeg/.png/.webp files in this folder get cycled through for
# image-only upload slots (product covers, staff photos, company logo).
# Any of those PLUS .pdf files get cycled through for document-type slots
# (customer documents, expense receipts), so drop a couple of PDFs in here too.
# Defaults to SAAS/public/dummy-photo (already has a handful of each) if unset.
ASSETS_DIR=../public/dummy-photo

# Password every seeded staff member gets (so you can log in as them afterwards
# to see the Sales Executive / Delivery Partner dashboards from their own view)
STAFF_PASSWORD=StaffPass123!
